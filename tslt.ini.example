# Lines starting with '#' or ';' are comments, and '#' also starts a trailing
# comment: `model = Qwen/Qwen3-8B  # note` reads as Qwen/Qwen3-8B.
# Quote a value to keep a literal '#': `name = "Qwen #1"`.
[LLM]
provider = Qwen

[LLM.Qwen]
name = SiliconFlow Qwen
protocol = openai
base_url = https://api.siliconflow.cn/v1
api_key = sk-XXXXX
model = Qwen/Qwen3.5-4B

[LLM.DSK]
base_url = https://api.deepseek.com
api_key = sk-xxxxxx
model = deepseek-v4-flash
# WinHTTP send/receive timeout in seconds (default 300). Raise it for slow
# reasoning models, lower it for fast local servers.
# timeout = 300
# Streaming is on by default; non-streamed replies only start after the whole
# answer is generated, which trips reverse-proxy timeouts on long inputs.
# Set to 0 only for gateways that reject "stream".
# stream = 1

[LLM.GPT]
name = OpenAI GPT (Responses API)
protocol = responses
base_url = https://api.openai.com/v1
api_key = sk-xxxxxx
model = gpt-5-mini
max_tokens = 8192
# Reasoning-only models reject temperature; a negative value omits it.
# temperature = -1

[LLM.Claude]
name = Anthropic Claude
protocol = anthropic
base_url = https://api.anthropic.com
api_key = sk-ant-xxxxxx
model = claude-sonnet-4-5
max_tokens = 8192
# Haiku-class models reject non-default temperature; -1 omits the field.
# temperature = -1

[Translate]
target_language = zh-CN
source_language = auto
temperature = 0.2

[Dictionary]
provider = dict.cn

# When the input is a plausible dictionary headword, tslt asks the dictionary before
# the language model; anything else goes straight to the model. Thresholds were probed
# against dict.cn: single English words resolve up to ~45 chars, English idioms up to
# about 6 words / 35 chars, Chinese entries up to ~8 chars. Trailing punctuation is
# stripped before the request, and a miss falls back to the model automatically.

# Longest single English word treated as a dictionary lookup.
# max_english_word_chars = 32
# Longest multi-word phrase, in words and in characters.
# max_phrase_words = 6
# max_phrase_chars = 35
# Longest unspaced CJK run (Chinese has no word separators).
# max_cjk_chars = 8

# Legacy key: when present it caps the English word bound and the CJK bound and
# restricts lookups to a single unspaced term, matching older behaviour.
# auto_select_max_characters = 20
