[LLM]
provider = Qwen

[LLM.Qwen]
name = SiliconFlow Qwen
protocol = openai
base_url = https://api.siliconflow.cn/v1
api_key = sk-XXXXX
model = Qwen/Qwen3.5-4B

[LLM.DSK]
base_url = https://api.deepseek.com
api_key = sk-xxxxxx
model = deepseek-v4-flash
# WinHTTP send/receive timeout in seconds (default 300). Raise it for slow
# reasoning models, lower it for fast local servers.
# timeout = 300

[LLM.GPT]
name = OpenAI GPT (Responses API)
protocol = responses
base_url = https://api.openai.com/v1
api_key = sk-xxxxxx
model = gpt-5-mini
max_tokens = 8192
# Reasoning-only models reject temperature; a negative value omits it.
# temperature = -1

[LLM.Claude]
name = Anthropic Claude
protocol = anthropic
base_url = https://api.anthropic.com
api_key = sk-ant-xxxxxx
model = claude-sonnet-4-5
max_tokens = 8192
# Haiku-class models reject non-default temperature; -1 omits the field.
# temperature = -1

[Translate]
target_language = zh-CN
source_language = auto
temperature = 0.2

[Dictionary]
provider = dict.cn
auto_select_max_characters = 20
